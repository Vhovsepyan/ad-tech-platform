# Template for environment-specific secrets. DO NOT commit real values.
# Create the actual secret with:
#   kubectl create secret generic audience-edge-secrets \
#     --from-literal=cookie-domain='.yourdsp.com'
#
# The cookie-domain value MUST start with a leading dot for subdomain coverage
# (e.g. ".yourdsp.com" covers sync.yourdsp.com, bid.yourdsp.com, etc.).
apiVersion: v1
kind: Secret
metadata:
  name: audience-edge-secrets
type: Opaque
stringData:
  cookie-domain: ".yourdsp.com"   # <-- replace with your actual domain before applying
