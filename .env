# ----------------------------------------
# AdTech Monorepo Environment Variables
# ----------------------------------------

# Campaign API (Postgres)
DATABASE_URL=postgres://adtech:secretpassword@localhost:5432/adtech_db

# RTB Engine (Redis)
REDIS_URL=redis://127.0.0.1:6379/

# Audience Edge
AUDIENCE_EDGE_URL=http://localhost:8083

# Shared Message Broker (Kafka/Redpanda)
KAFKA_BROKERS=localhost:19092
KAFKA_CAMPAIGN_TOPIC=campaign-updates

# Audience Edge: comma-separated hostnames that cookie sync may redirect to
ALLOWED_REDIRECT_HOSTS=ib.adnxs.com,ads.openx.net,cm.g.doubleclick.net
# Domain set on the DSP tracking cookie — must start with a leading dot for subdomain coverage
COOKIE_DOMAIN=.localhost

# Service Ports
CAMPAIGN_API_PORT=8080
RTB_ENGINE_PORT=8081